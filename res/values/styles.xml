<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BaseAppTheme: everything that is the same in light and dark. -->
    <style name="BaseAppTheme" parent="@android:style/Theme.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_window_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Base application theme. Dark bars with light icons by default. -->
    <style name="AppTheme" parent="@style/BaseAppTheme">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- No fullscreen parent: the splash keeps the status bar, like the design. -->
    <style name="SplashTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

</resources>